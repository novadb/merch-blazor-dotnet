@* Document, header and footer, around every page. Not a Blazor layout (@layout): a layout cannot take data from the
   page it wraps, and this needs the page's region, texts and region-switch targets, so each page wraps itself in it.
   <title> and the other head links come from the page's <PageTitle> and <HeadContent>, through <HeadOutlet />. *@
@inject IConfiguration Config
<!DOCTYPE html>
<html lang="@Page.Region.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    @if (!string.IsNullOrEmpty(ShopDomain)) { <meta name="shopify-domain" content="@ShopDomain" /> }
    @if (!string.IsNullOrEmpty(ShopToken)) { <meta name="shopify-token" content="@ShopToken" /> }
    <HeadOutlet />
    @* Assets[…]: the file's fingerprinted name (MapStaticAssets), cached by the browser for good. It is relative (Blazor
       expects a <base href>, which would also move the forms' action="#range"): the "/" makes it absolute. *@
    <link rel="stylesheet" href="/@Assets["site.css"]" />
    <script src="/@Assets["site.js"]" type="module"></script>
</head>
<body data-lang="@Page.Region.Code" data-shop="@(string.IsNullOrEmpty(ShopDomain) || string.IsNullOrEmpty(ShopToken) ? null : "")" data-text="@(Page.Text is null ? null : System.Text.Json.JsonSerializer.Serialize(Page.Text.ForClient()))">
    <a class="skip" href="#main">@(Page.Text?["skip"] ?? "Skip to content")</a>
    @if (Page.Text is { } text && Page.Site is { } site)
    {
        <header class="site-header">
            <div class="site-header__inner">
                <a class="logo" href="@site.Home.Url">@site.Home.Title</a>
                <nav class="site-nav" aria-label='@text["mainNav"]'>
                    <ul>
                        @foreach (var item in site.Home.Children)
                        {
                            <li>
                                <a href="@item.Url">@item.NavTitle</a>
                                @if (item.Children.Count > 0)
                                {
                                    <ul class="site-nav__sub">
                                        @foreach (var child in item.Children)
                                        {
                                            <li><a href="@child.Url">@child.NavTitle</a></li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                </nav>
                <form class="search" role="search" method="post" action="/@Page.Region.Code/search">
                    <input type="search" name="q" placeholder='@text["searchPlaceholder"]' aria-label='@text["search"]' autocomplete="off" data-suggest="/api/suggest" />
                </form>
                <div class="site-header__tools">
                    <nav class="regions" aria-label='@text["region"]'>
                        @foreach (var r in Region.All)
                        {
                            if (r == Page.Region)
                            {
                                <span class="regions__item" aria-current="true" title="@r.Title">@r.Short</span>
                            }
                            else
                            {
                                <a class="regions__item" href="@(Page.Alternates.GetValueOrDefault(r) ?? $"/{r.Code}/")" hreflang="@r.HtmlLang" title="@r.Title">@r.Short</a>
                            }
                        }
                    </nav>
                </div>
            </div>
        </header>
    }
    <main id="main">@ChildContent</main>
    <footer class="site-footer">
        @if (Page.Text is { } footerText)
        {
            <p>@footerText.Html("poweredBy")</p>
        }
        <a class="site-footer__repo" href="https://github.com/novadb/@Repo">@Repo</a>
    </footer>
    @* The NovaDB logo in the corner: decoration only, the footer's line names NovaDB in words. *@
    <aside class="source" aria-hidden="true"></aside>
</body>
</html>

@code {
    /// <summary>This demo's repository on GitHub (github.com/novadb/…), linked from the corner of every page.</summary>
    const string Repo = "merch-blazor-dotnet";

    [Parameter, EditorRequired] public RegionPage Page { get; set; } = null!;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string? ShopDomain => Config["SHOPIFY_DOMAIN"];
    string? ShopToken => Config["SHOPIFY_STOREFRONT_TOKEN"];
}
