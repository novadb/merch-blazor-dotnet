@page "/{RegionCode}/search"
@* /{region}/search: full-text search over products (with facets) and pages; the query is the parameter `q`. The page renders
   again for a search or a facet form (GET forms: their fields are in the address). *@
@inject RegionContext Site
@inject NavigationManager Navigation
@inject Catalog Catalog
@inject SiteTree Tree

@if (products is not null)
{
    var text = Site.Text;
    @* No canonical or hreflang: internal search results are not meant to be indexed. *@
    <PageTitle>@text["search"] · @text["siteName"]</PageTitle>
    <section class="merchHero merchHero--compact">
        <p class="merchKicker">@text["search"]</p>
        <h1 class="merchDisplay">@text.SearchTitle(query)</h1>
        <SearchBox ListId="suggest-2" Large="true" Query="@query" />
        @if (pages.Count > 0)
        {
            <nav class="search-pages" aria-label='@text["pagesFound"]'>
                <span>@text["pagesFound"]:</span>
                @foreach (var p in pages)
                {
                    <a href="@p.Url">@p.Title</a>
                }
            </nav>
        }
    </section>
    <RangeSection Products="products" DefaultSort="@(relevant ? "relevance" : "name")" GroupNames="groupNames" Query="@query" />
}

@code {
    [Parameter] public string RegionCode { get; set; } = "";
    [SupplyParameterFromQuery(Name = "q")] string? Q { get; set; }

    string query = "";
    bool relevant;
    List<Product>? products;
    List<SitePage> pages = [];
    Dictionary<int, string> groupNames = [];

    protected override async Task OnInitializedAsync()
    {
        if (Region.Find(RegionCode) is not { } region)
        {
            Navigation.NotFound();
            return;
        }
        await Site.LoadAsync(region);
        query = (Q ?? "").Trim();
        var filter = Catalog.SearchFilter(query, Schema.ProductSearchFields);
        relevant = filter is not null;
        var found = Catalog.LoadAsync(region, filter, filter is null ? null : "$score");
        var matching = Tree.SearchAsync(region, query, 5);
        groupNames = await Tree.LoadGroupsAsync(region);
        products = await found;
        pages = await matching;
        Site.SetAlternates(Region.All.ToDictionary(r => r, r => $"/{r.Code}/search"));
    }
}
