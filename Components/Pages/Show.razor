@page "/{RegionCode}/{*Path}"
@* /{region}/{path}: a CMS page (with its live product range) or a product from the PIM. The facet and sort forms are GET
   forms: the page renders again with their fields in the address, which the range reads (RangeSection). *@
@inject RegionContext Site
@inject NavigationManager Navigation
@inject Catalog Catalog
@inject SiteTree Tree
@inject Images Pictures
@inject IConfiguration Config

@if (seo is not null)
{
    var text = Site.Text;
    <PageTitle>@title · @text["siteName"]</PageTitle>
    <HeadContent>
        <link rel="canonical" href="@seo.Canonical" />
        @foreach (var (hreflang, href) in seo.Alternates)
        {
            <link rel="alternate" hreflang="@hreflang" href="@href" />
        }
        @if (seo.Description is { } description)
        {
            <meta name="description" content="@description" />
        }
        @if (seo.Robots is { } robots)
        {
            <meta name="robots" content="@robots" />
        }
        @if (product?.Image is { } hero)
        {
            @* The product picture is the largest thing above the fold: the browser fetches it before it has laid out the page. *@
            var srcset = Images.SrcSet(hero); // none for SVG: then the file itself
            <link rel="preload" as="image" href="@(srcset is null ? hero : null)" imagesrcset="@srcset" imagesizes="@(srcset is null ? null : "(min-width: 760px) 55vw, 100vw")" />
        }
    </HeadContent>
    <Crumbs Items="crumbs" />
    @if (product is { } p)
    {
        <ProductPage Product="p" GroupName="@groupName" Contents="contents" Similar="similar" Accessories="accessories" SpareParts="spareParts" />
    }
    else
    {
        <Content Node="document" Ctx="ctx">
            <AfterFirst>
                @if (rangeProducts is not null)
                {
                    <RangeSection Products="rangeProducts" DefaultSort="name" GroupNames="groupNames" />
                }
            </AfterFirst>
        </Content>
    }
}

@code {
    /// <summary>The request: a page is rendered once on the server (static SSR), while it is open.</summary>
    [CascadingParameter] HttpContext HttpContext { get; set; } = null!;
    [Parameter] public string RegionCode { get; set; } = "";
    [Parameter] public string? Path { get; set; }

    Seo? seo;
    string title = "";
    List<Target> crumbs = [];
    ContentContext ctx = null!;

    // A CMS page
    VNode? document;
    List<Product>? rangeProducts;
    Dictionary<int, string> groupNames = [];

    // A product
    Product? product;
    List<Product> similar = [];
    List<Product> accessories = [];
    List<Product> spareParts = [];
    List<SetRow> contents = [];
    SeoHints? seoHints;
    string? groupName;

    protected override async Task OnInitializedAsync()
    {
        // The canonical form of the URL (`/de/`, `/de/shop`) is made in Program.cs, by a permanent redirect.
        if (Region.Find(RegionCode) is not { } region)
        {
            Navigation.NotFound();
            return;
        }
        await Site.LoadAsync(region);
        var path = (Path ?? "").Trim('/');
        var groups = await Tree.LoadGroupsAsync(region);
        var found = Site.Map.ByPath.TryGetValue(path, out var page)
            ? await LoadPageAsync(page, groups)
            : await LoadProductAsync(path, groups);
        if (!found)
        {
            Navigation.NotFound();
            return;
        }
        seo = Seo.Of(HttpContext.Request, Config, product?.Url ?? page!.Url, Site.Alternates, seoHints);
    }

    async Task<bool> LoadPageAsync(SitePage page, Dictionary<int, string> groups)
    {
        var otherMap = Tree.LoadAsync(Site.Region.OtherLanguage); // the page's path in the other language is its hreflang link
        var embeddedIds = ContentContext.ReferencedIds(page.Content).Where(id => !Site.Map.Pages.ContainsKey(id)).ToList();
        var wantedImages = ContentContext.ImageIds(page.Content); // plus the teaser picture of every page
        foreach (var p in Site.Map.Pages.Values) if (p.ImageId is { } id) wantedImages.Add(id);
        var embedded = Catalog.ByIdsAsync(embeddedIds, Site.Region);
        var products = page.GroupRefs.Length > 0 ? Catalog.LoadAsync(Site.Region, $"{Schema.Product.Group} = {string.Join(", ", page.GroupRefs)}") : Task.FromResult<List<Product>>([]);
        var pictures = await Pictures.ByIdsAsync(wantedImages);

        var targets = Site.Map.Pages.Values.ToDictionary(p => p.Id, p => new Target(p.Url, p.Title, p.ImageId is { } id ? pictures.GetValueOrDefault(id) : null));
        var embeddedProducts = await embedded;
        foreach (var p in embeddedProducts) targets[p.Id] = new Target(p.Url, p.Name, p.Image);
        title = page.Title;
        Site.SetAlternates(Site.Region.Alternates(page.Path, (await otherMap).Pages.GetValueOrDefault(page.Id)?.Path));
        crumbs = [.. Site.Map.Breadcrumb(page).Select(ToCrumb)];
        document = page.Content;
        ctx = new ContentContext(embeddedProducts.ToDictionary(p => p.Id), targets, pictures);
        if (await products is { Count: > 0 } all) rangeProducts = all;
        groupNames = groups;
        return true;
    }

    async Task<bool> LoadProductAsync(string path, Dictionary<int, string> groups)
    {
        if (path.Length == 0 || await Catalog.ByPathAsync(Site.Region, path) is not { } found) return false;
        var (similarTask, accessoriesTask, sparePartsTask, contentsTask) = (Catalog.ByIdsAsync(found.Similar, Site.Region),
            Catalog.ByIdsAsync(found.Accessories, Site.Region), Catalog.ByIdsAsync(found.SpareParts, Site.Region), Catalog.SetContentsAsync(found, Site.Region));
        // The same product in the other language: its path is the hreflang link.
        var other = (await Catalog.ByIdsAsync([found.Id], Site.Region.OtherLanguage)).FirstOrDefault();
        var category = found.GroupId is { } group ? Site.Map.CategoryPage(group) : null;
        title = found.Seo.Title ?? found.Name;
        seoHints = found.Seo;
        Site.SetAlternates(Site.Region.Alternates(found.Path, other?.Path));
        crumbs = [.. Site.Map.Breadcrumb(category).Select(ToCrumb), new Target(found.Url, found.Name, null)];
        
        product = found;
        (similar, accessories, spareParts, contents) = (await similarTask, await accessoriesTask, await sparePartsTask, await contentsTask);
        groupName = found.GroupId is { } id ? groups.GetValueOrDefault(id) : null;
        return true;
    }

    /// <summary>A page in the breadcrumb, named as in the navigation.</summary>
    static Target ToCrumb(SitePage p) => new(p.Url, p.NavTitle, null);
}
