@page "/{RegionCode}/{*Path}"
@* /{region}/{path}: a CMS page (with its live product range) or a product from the PIM. The facet and sort forms post
   to the page itself: the answer is the page, rendered with the posted fields. *@
@inherits RegionPage
@inject Catalog Catalog
@inject Images Pictures
@inject IConfiguration Config

@if (seo is not null)
{
    var text = Text!;
    <Shell Page="this">
        <PageTitle>@title · @text["siteName"]</PageTitle>
        <HeadContent>
            <link rel="canonical" href="@seo.Canonical" />
            @foreach (var (hreflang, href) in seo.Alternates)
            {
                <link rel="alternate" hreflang="@hreflang" href="@href" />
            }
            @if (product?.Image is { } hero)
            {
                @* The product picture is the largest thing above the fold: the browser fetches it before it has laid out the page. *@
                var srcset = Images.SrcSet(hero); // none for SVG: then the file itself
                <link rel="preload" as="image" href="@(srcset is null ? hero : null)" imagesrcset="@srcset" imagesizes="@(srcset is null ? null : "(min-width: 760px) 55vw, 100vw")" />
            }
        </HeadContent>
        <Crumbs Items="crumbs" Label='@text["breadcrumb"]' />
        @if (product is { } p)
        {
            var specs = new (string Name, string Value)[]
            {
                (text["sku"], p.Sku ?? ""),
                (text["colour"], p.Color is { } color ? text.Value(color) : ""),
                (text["material"], string.Join(", ", p.Materials.Select(text.Value))),
                (text["volume"], p.Volume is { } volume ? $"{volume} ml" : ""),
                (text["screenSize"], p.ScreenSize is { } inches ? $"{inches}″" : ""),
                (text["finish"], string.Join(", ", p.Finishes.Select(text.Value))),
                (text["pieces"], p.Pieces is { } pieces ? text.PieceCount(pieces) : ""),
            };
            <article class="pdp">
                <div class="pdp__media">
                    @if (p.Image is { } src)
                    {
                        <img src="@src" srcset="@Images.SrcSet(src)" sizes="(min-width: 760px) 55vw, 100vw" alt="@p.Name" width="400" height="400" />
                    }
                </div>
                <div class="pdp__info">
                    @if (groupName is not null)
                    {
                        <p class="merchKicker">@groupName</p>
                    }
                    <h1 class="pdp__name">@p.Name</h1>
                    <p class="pdp__price">@Region.FormatPrice(p.Price)<span class="@(p.InStock == false ? "badge badge--muted" : "badge")">@(p.InStock == false ? text["soldOut"] : text["available"])</span></p>
                    @if (p.ShopifyId is not null && p.InStock != false)
                    {
                        <div class="pdp__buy" data-shopify-product="@p.ShopifyId"></div>
                    }
                    @if (p.DescriptionHtml is { } description)
                    {
                        <div class="pdp__description">@((MarkupString)description)</div>
                    }
                    <dl class="specs">
                        @foreach (var (name, value) in specs.Where(s => s.Value.Length > 0))
                        {
                            <div><dt>@name</dt><dd>@value</dd></div>
                        }
                    </dl>
                </div>
            </article>
            @if (similar.Count > 0)
            {
                <section class="merchBand">
                    <h2 class="headline">@text["similar"]</h2>
                    <div class="grid">
                        @foreach (var s in similar)
                        {
                            <ProductCard Product="s" Ctx="ctx" />
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <Content Node="document" Ctx="ctx">
                <AfterFirst>
                    @if (range is not null)
                    {
                        <RangeSection Range="range" Ctx="ctx" GroupNames="groupNames" />
                    }
                </AfterFirst>
            </Content>
        }
    </Shell>
}

@code {
    [Parameter] public string RegionCode { get; set; } = "";
    [Parameter] public string? Path { get; set; }

    Seo? seo;
    string title = "";
    List<Target> crumbs = [];
    ContentContext ctx = null!;

    // A CMS page
    VNode? document;
    ProductRange? range;
    Dictionary<int, string> groupNames = [];

    // A product
    Product? product;
    List<Product> similar = [];
    string? groupName;

    protected override async Task OnInitializedAsync()
    {
        // The canonical form of the URL (`/de/`, `/de/shop`) is made in Program.cs, by a permanent redirect.
        if (Region.Find(RegionCode) is not { } region)
        {
            Navigation.NotFound();
            return;
        }
        await LoadRegionAsync(region);
        var path = (Path ?? "").Trim('/');
        var otherSite = Tree.LoadAsync(region.OtherLanguage);
        var groups = await Tree.LoadGroupsAsync(region);
        var found = Site!.ByPath.TryGetValue(path, out var page)
            ? await LoadPageAsync(page, await otherSite, groups)
            : await LoadProductAsync(path, groups);
        if (!found)
        {
            Navigation.NotFound();
            return;
        }
        seo = Seo.Of(HttpContext.Request, Config, product?.Url ?? page!.Url, Alternates);
    }

    async Task<bool> LoadPageAsync(SitePage page, SiteMap otherSite, Dictionary<int, string> groups)
    {
        var embeddedIds = ContentContext.ReferencedIds(page.Content).Where(id => !Site!.Pages.ContainsKey(id)).ToList();
        var wantedImages = ContentContext.ImageIds(page.Content); // plus the teaser picture of every page
        foreach (var p in Site!.Pages.Values) if (p.ImageId is { } id) wantedImages.Add(id);
        var embedded = Catalog.ByIdsAsync(embeddedIds, Region);
        var products = page.GroupRefs.Length > 0 ? Catalog.LoadAsync(Region, $"{Schema.Product.Group} = {string.Join(", ", page.GroupRefs)}") : Task.FromResult<List<Product>>([]);
        var pictures = await Pictures.ByIdsAsync(wantedImages);

        var targets = Site.Pages.Values.ToDictionary(p => p.Id, p => new Target(p.Url, p.Title, p.ImageId is { } id ? pictures.GetValueOrDefault(id) : null));
        foreach (var p in await embedded) targets[p.Id] = new Target(p.Url, p.Name, p.Image);
        title = page.Title;
        Alternates = Region.Alternates(page.Path, otherSite.Pages.GetValueOrDefault(page.Id)?.Path);
        crumbs = [.. Site.Breadcrumb(page).Select(ToCrumb)];
        document = page.Content;
        ctx = new ContentContext(Region, Text!, (await embedded).ToDictionary(p => p.Id), targets,
            ContentContext.ImageIds(page.Content).Where(pictures.ContainsKey).ToDictionary(id => id, id => pictures[id]));
        if (await products is { Count: > 0 } all) range = Catalog.ApplySelection(all, Catalog.ParseSelection(Form), "name");
        groupNames = groups;
        return true;
    }

    async Task<bool> LoadProductAsync(string path, Dictionary<int, string> groups)
    {
        if (path.Length == 0 || await Catalog.ByPathAsync(Region, path) is not { } found) return false;
        var similarTask = Catalog.ByIdsAsync(found.Similar, Region);
        var other = (await Catalog.ByIdsAsync([found.Id], Region.OtherLanguage)).FirstOrDefault();
        var category = found.GroupId is { } group ? Site!.CategoryPage(group) : null;
        title = found.Name;
        Alternates = Region.Alternates(found.Path, other?.Path);
        crumbs = [.. Site!.Breadcrumb(category).Select(ToCrumb), new Target(found.Url, found.Name, null)];
        ctx = new ContentContext(Region, Text!);
        product = found;
        similar = await similarTask;
        groupName = found.GroupId is { } id ? groups.GetValueOrDefault(id) : null;
        return true;
    }

    /// <summary>A page in the breadcrumb, named as in the navigation.</summary>
    static Target ToCrumb(SitePage p) => new(p.Url, p.NavTitle, null);
}
